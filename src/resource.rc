#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "audy.manifest"

IDI_AUDY_ICON ICON "../assets/audy.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, 0, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Audy"
            VALUE "FileVersion", VERSION_STRING
            VALUE "LegalCopyright", "Copyright © 2023 Yendric Van Roey"
            VALUE "ProductName", "Audy"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 180, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audy Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Change Shortcut:", -1, 7, 7, 166, 8
    CONTROL         "", IDC_HOTKEY, HOTKEY_CLASS, WS_TABSTOP, 7, 18, 166, 14
    DEFPUSHBUTTON   "OK", IDOK, 69, 39, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 123, 39, 50, 14
END
