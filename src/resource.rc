#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_AUDY_ICON ICON "../assets/audy.ico"

IDD_SETTINGS DIALOGEX 0, 0, 180, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audy Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Change Shortcut:", IDC_STATIC, 7, 7, 166, 8
    CONTROL         "", IDC_HOTKEY, HOTKEY_CLASS, WS_TABSTOP, 7, 18, 166, 14
    DEFPUSHBUTTON   "OK", IDOK, 69, 39, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 123, 39, 50, 14
END